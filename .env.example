# AILORA .env.example — safe placeholders only.
# Never commit real credentials in a .env file.

COMPOSE_PROJECT_NAME=ailora

AILORA_APP_NAME=AILORA
AILORA_DEBUG=false
AILORA_ENVIRONMENT=local

AILORA_DB_NAME=ailora_db
AILORA_DB_USER=ailora
AILORA_DB_PASSWORD=CHANGE_ME_TO_A_RANDOM_HEX_PASSWORD
AILORA_DATABASE_URL=postgresql+psycopg://ailora:CHANGE_ME_TO_A_RANDOM_HEX_PASSWORD@localhost:55432/ailora_db
AILORA_DATABASE_POOL_SIZE=5
AILORA_DATABASE_MAX_OVERFLOW=10
AILORA_DATABASE_POOL_TIMEOUT_SECONDS=5
AILORA_DATABASE_POOL_RECYCLE_SECONDS=1800
AILORA_DATABASE_PROBE_TIMEOUT_SECONDS=3

AILORA_SECRET_KEY=CHANGE_ME_BEFORE_ANY_NON_LOCAL_USE
AILORA_ALGORITHM=HS256
AILORA_ACCESS_TOKEN_EXPIRE_MINUTES=30

AILORA_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

AILORA_ENABLE_TRACING=false

# Live orbital-data provider is explicit and fail-closed by default.
AILORA_ENABLE_LIVE_SPACE_DATA_PROVIDER=false
AILORA_CELESTRAK_BASE_URL=https://celestrak.org
AILORA_CELESTRAK_TIMEOUT_SECONDS=5
AILORA_CELESTRAK_MAX_RESPONSE_BYTES=131072

AILORA_ENABLE_OYA_VOICE_SERVICE=false
AILORA_OYA_API_KEY=
AILORA_OYA_BASE_URL=
AILORA_OYA_WEBHOOK_SECRET=
AILORA_OYA_ENVIRONMENT=production-grade

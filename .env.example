"""
AILORA .env.example — safe defaults only; NO real secrets.
Copy to .env and set values for local development.
"""

# Application
AILORA_APP_NAME=AILORA
AILORA_DEBUG=false
AILORA_ENVIRONMENT=local

# Database (update for local PostgreSQL)
AILORA_DATABASE_URL=postgresql+psycopg://ailora:ailora@localhost:5432/ailora_db

# Security — MUST be changed before any non-local use
AILORA_SECRET_KEY=CHANGE_ME_BEFORE_ANY_NON_LOCAL_USE
AILORA_ALGORITHM=HS256
AILORA_ACCESS_TOKEN_EXPIRE_MINUTES=30

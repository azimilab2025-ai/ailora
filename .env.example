# AILORA .env.example — safe defaults only; NO real secrets.
# Copy to .env and set values for local development.

# Application
AILORA_APP_NAME=AILORA
AILORA_DEBUG=false
AILORA_ENVIRONMENT=local

# Database (update for local PostgreSQL)
AILORA_DATABASE_URL=postgresql+psycopg://ailora:ailora@localhost:5432/ailora_db

# Security — MUST be changed before any non-local use
AILORA_SECRET_KEY=CHANGE_ME_BEFORE_ANY_NON_LOCAL_USE
AILORA_ALGORITHM=HS256
AILORA_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Observability
AILORA_ENABLE_TRACING=false

# ── Oya Voice AI — PROTOTYPE PHASE (disabled by default) ────────────────────
# Oya is intentionally disabled during the prototype phase to optimize
# initial operational overhead.  Do NOT set ENABLE_OYA_VOICE_SERVICE=true
# without meeting the production revenue gate and explicit authorization.
AILORA_ENABLE_OYA_VOICE_SERVICE=false

# Oya production credentials — leave empty in prototype/development/test.
# These values must NEVER be committed to source control.
AILORA_OYA_API_KEY=
AILORA_OYA_BASE_URL=
AILORA_OYA_WEBHOOK_SECRET=
AILORA_OYA_ENVIRONMENT=prototype

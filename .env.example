# AILORA .env.example — safe placeholders only.
# Never commit real credentials in a .env file.

# Docker Compose isolation
COMPOSE_PROJECT_NAME=bob-space-project-intake-2026

# Application
AILORA_APP_NAME=AILORA
AILORA_DEBUG=false
AILORA_ENVIRONMENT=local

# PostgreSQL container
AILORA_DB_NAME=ailora_db
AILORA_DB_USER=ailora
AILORA_DB_PASSWORD=CHANGE_ME_TO_A_RANDOM_HEX_PASSWORD

# Local host connection used by Alembic and local Python processes
AILORA_DATABASE_URL=postgresql+psycopg://ailora:CHANGE_ME_TO_A_RANDOM_HEX_PASSWORD@localhost:55432/ailora_db

# Security
AILORA_SECRET_KEY=CHANGE_ME_BEFORE_ANY_NON_LOCAL_USE
AILORA_ALGORITHM=HS256
AILORA_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Observability
AILORA_ENABLE_TRACING=false

# Oya Voice AI — disabled during prototype phase
AILORA_ENABLE_OYA_VOICE_SERVICE=false

# Leave credentials empty during prototype/development/test
AILORA_OYA_API_KEY=
AILORA_OYA_BASE_URL=
AILORA_OYA_WEBHOOK_SECRET=
AILORA_OYA_ENVIRONMENT=prototype
